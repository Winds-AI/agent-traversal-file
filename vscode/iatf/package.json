{
  "name": "iatf",
  "displayName": "IATF",
  "description": "Language support for IATF files with syntax highlighting, validation, and navigation",
  "license": "MIT",
  "version": "0.1.5",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:iatf",
    "onCommand:iatf.openPreview"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Winds-AI/agent-traversal-file.git",
    "directory": "vscode/iatf"
  },
  "files": [
    "CHANGELOG.md",
    "extension.js",
    "LICENSE",
    "README.md",
    "language-configuration.json",
    "package.json",
    "syntaxes/iatf.tmLanguage.json"
  ],
  "publisher": "Winds-AI",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "iatf",
    "indexed-documentation",
    "ai-agents",
    "agent-docs",
    "agent-navigation",
    "auto-indexing",
    "section-index",
    "knowledge-files",
    "language-server"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "iatf.openPreview",
        "title": "IATF: Open Preview",
        "icon": "$(open-preview)"
      }
    ],
    "languages": [
      {
        "id": "iatf",
        "aliases": [
          "IATF"
        ],
        "extensions": [
          ".iatf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "iatf",
        "scopeName": "source.iatf",
        "path": "./syntaxes/iatf.tmLanguage.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "iatf.openPreview",
          "when": "resourceLangId == iatf",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "IATF",
      "properties": {
        "iatf.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the IATF Language Server for enhanced features (diagnostics, go-to-definition, hover, completion)"
        },
        "iatf.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the iatf-lsp executable. If empty, uses the bundled server or looks in PATH."
        },
        "iatf.completion.mode": {
          "type": "string",
          "enum": [
            "context",
            "manual",
            "aggressive"
          ],
          "default": "context",
          "description": "Controls autocomplete behavior. 'context' only suggests in IATF syntax positions, 'manual' limits suggestions to explicit completion requests, and 'aggressive' suggests more broadly."
        },
        "iatf.completion.includeTitles": {
          "type": "boolean",
          "default": true,
          "description": "Include section title suggestions from INDEX and CONTENT headings."
        },
        "iatf.completion.smartInsert": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, completions can insert missing syntax characters like closing braces when appropriate."
        }
      }
    },
    "configurationDefaults": {
      "[iatf]": {
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            {
              "scope": "keyword.control.header.iatf",
              "settings": {
                "foreground": "#8B949E",
                "fontStyle": "bold"
              }
            },
            {
              "scope": "keyword.control.section.iatf",
              "settings": {
                "foreground": "#7D8590",
                "fontStyle": ""
              }
            },
            {
              "scope": "keyword.other.metadata.important.iatf",
              "settings": {
                "foreground": "#E5C07B",
                "fontStyle": "bold"
              }
            },
            {
              "scope": "entity.name.document.title.iatf",
              "settings": {
                "foreground": "#F2CC60",
                "fontStyle": "bold"
              }
            },
            {
              "scope": "keyword.other.metadata.iatf",
              "settings": {
                "foreground": "#6E7681",
                "fontStyle": ""
              }
            },
            {
              "scope": "markup.heading.marker.iatf",
              "settings": {
                "foreground": "#6E7681",
                "fontStyle": ""
              }
            },
            {
              "scope": "markup.heading.title.iatf",
              "settings": {
                "foreground": "#C9D1D9",
                "fontStyle": ""
              }
            },
            {
              "scope": "entity.name.section.iatf",
              "settings": {
                "foreground": "#ADB5BD"
              }
            },
            {
              "scope": "constant.numeric.range.iatf",
              "settings": {
                "foreground": "#B5CEA8"
              }
            },
            {
              "scope": "constant.numeric.iatf",
              "settings": {
                "foreground": "#B5CEA8"
              }
            },
            {
              "scope": "constant.numeric.date.iatf",
              "settings": {
                "foreground": "#98C379",
                "fontStyle": "bold"
              }
            },
            {
              "scope": "string.unquoted.summary.iatf",
              "settings": {
                "foreground": "#DCDCAA",
                "fontStyle": ""
              }
            },
            {
              "scope": "punctuation.definition.quote.iatf",
              "settings": {
                "foreground": "#6E7681",
                "fontStyle": ""
              }
            },
            {
              "scope": "keyword.other.timestamp.iatf",
              "settings": {
                "foreground": "#61AFEF",
                "fontStyle": "bold"
              }
            },
            {
              "scope": "keyword.other.hash.iatf",
              "settings": {
                "foreground": "#6E7681"
              }
            },
            {
              "scope": "constant.other.hash.iatf",
              "settings": {
                "foreground": "#5C6370"
              }
            },
            {
              "scope": "meta.section.block.iatf",
              "settings": {
                "foreground": "#5C6370"
              }
            },
            {
              "scope": "constant.other.reference.iatf",
              "settings": {
                "foreground": "#4FC1FF",
                "fontStyle": "underline"
              }
            },
            {
              "scope": "markup.fenced_code.block.iatf",
              "settings": {
                "foreground": "#CE9178"
              }
            },
            {
              "scope": "comment.block.iatf",
              "settings": {
                "foreground": "#57606A",
                "fontStyle": ""
              }
            },
            {
              "scope": "meta.brace.iatf",
              "settings": {
                "foreground": "#57606A"
              }
            },
            {
              "scope": "punctuation.separator.key-value.iatf",
              "settings": {
                "foreground": "#57606A"
              }
            },
            {
              "scope": "string.unquoted.iatf",
              "settings": {
                "foreground": "#8B949E"
              }
            }
          ]
        }
      }
    }
  }
}
